{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "api:generate": "cd .. && ${PYTHON_BIN:-python3} scripts/generate_openapi.py docs/api/openapi.json && npm --prefix frontend exec openapi-typescript -- docs/api/openapi.json --output frontend/src/types/generated/api.ts && npm --prefix frontend exec prettier -- --write frontend/src/types/generated/api.ts",
    "api:check": "cd .. && PYTHON_BIN=${PYTHON_BIN:-python3} scripts/check_api_contracts.sh",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc -b"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "ky": "^1.11.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "7.18.2",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@eslint/js": "^9.36.0",
    "@playwright/experimental-ct-react": "^1.62.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "^4.11.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.4.0",
    "happy-dom": "20.11.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "postcss": "8.5.23",
    "tar": "7.5.21"
  }
}
